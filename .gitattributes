# Normalize line endings: source stays LF so the repo builds on Linux CI.
* text=auto

*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.list      text eol=lf
*.prop      text eol=lf
*.properties text eol=lf
*.gradle    text eol=lf
gradlew     text eol=lf
.gitignore  text eol=lf
LICENSE     text eol=lf

# Windows batch files must stay CRLF.
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary assets.
*.jar       binary
*.apk       binary
*.png       binary
*.jpg       binary
*.jks       binary
*.keystore  binary
